# Pooled Neon connection for application runtime
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct Neon connection for Prisma CLI workflows
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

HOST=0.0.0.0
PORT=3001
JWT_SECRET="replace-with-a-long-random-secret"
API_BASE_URL="http://localhost:3001"
APP_BASE_URL="http://localhost:3000"
CLERK_SECRET_KEY=""
UPLOADS_DIR="uploads"

# Local and Vercel Preview default to Base Sepolia.
# Vercel Production defaults to Base Mainnet.
BLOCKCHAIN_ENABLED="false"
CHAIN_ENV="preview"
CHAIN_RPC_URL="https://sepolia.base.org"
CHAIN_ID="84532"
CHAIN_PRIVATE_KEY=""
CHAIN_CONTRACT_ADDRESS=""

# Required for private contract document uploads to Vercel Blob
BLOB_READ_WRITE_TOKEN=""
